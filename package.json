{
	"name": "env-editor",
	"displayName": ".env editor",
	"description": "Hides .env values in the editor, with Show/Hide buttons",
	"version": "0.1.0",
	"publisher": "MARCROCK22",
	"private": false,
	"repository": {
		"type": "git",
		"url": "https://github.com/MARCROCK22/env-editor.git"
	},
	"license": "MIT",
	"engines": {
		"vscode": "^1.146.0"
	},
	"categories": [
		"Other"
	],
	"activationEvents": [
		"onLanguage:dotenv",
		"onStartupFinished"
	],
	"capabilities": {
		"untrustedWorkspaces": {
			"supported": true
		}
	},
	"contributes": {
		"configurationDefaults": {
			"[dotenv]": {
				"editor.wordBasedSuggestions": "off",
				"editor.find.seedSearchStringFromSelection": "never"
			}
		}
	},
	"main": "./out/extension.js",
	"files": [
		"out/*.js",
		"CHANGELOG.md"
	],
	"scripts": {
		"vscode:prepublish": "npm run compile",
		"compile": "tsc -p ./",
		"lint": "eslint src test",
		"test": "npm run compile && node --test",
		"watch": "tsc -w -p ./"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@types/vscode": "^1.146.0",
		"eslint": "^10.14.0",
		"typescript": "~6.0.3",
		"typescript-eslint": "^8.72.2"
	}
}
