{
	"name": "env-editor",
	"displayName": ".env editor",
	"description": "Edit .env files with every value hidden: Show/Hide per variable, Show all / Hide all",
	"version": "0.2.0",
	"publisher": "MARCROCK22",
	"icon": "images/icon.png",
	"galleryBanner": {
		"color": "#1e2327",
		"theme": "dark"
	},
	"private": false,
	"repository": {
		"type": "git",
		"url": "https://github.com/MARCROCK22/env-editor.git"
	},
	"license": "MIT",
	"engines": {
		"vscode": "^1.146.0"
	},
	"categories": [
		"Other"
	],
	"activationEvents": [
		"onLanguage:dotenv",
		"onStartupFinished"
	],
	"capabilities": {
		"untrustedWorkspaces": {
			"supported": true
		}
	},
	"contributes": {
		"customEditors": [
			{
				"viewType": "uwu.env",
				"displayName": ".env editor",
				"selector": [
					{
						"filenamePattern": "*.env"
					},
					{
						"filenamePattern": ".env.*"
					}
				],
				"priority": "default"
			}
		],
		"grammars": [
			{
				"scopeName": "env-editor.mask",
				"path": "./syntaxes/mask.injection.json",
				"injectTo": [
					"source.dotenv"
				]
			}
		],
		"configurationDefaults": {
			"[dotenv]": {
				"editor.wordBasedSuggestions": "off",
				"editor.find.seedSearchStringFromSelection": "never"
			},
			"editor.tokenColorCustomizations": {
				"[*]": {
					"textMateRules": [
						{
							"scope": [
								"property.value.dotenv",
								"string.quoted.double.dotenv",
								"string.quoted.single.dotenv",
								"constant.character.escape.dotenv",
								"variable.interpolation.dotenv",
								"keyword.interpolation.begin.dotenv",
								"keyword.interpolation.end.dotenv"
							],
							"settings": {
								"foreground": "#00000000"
							}
						}
					]
				}
			}
		}
	},
	"main": "./out/extension.js",
	"files": [
		"out/*.js",
		"media/*",
		"CHANGELOG.md",
		"images/icon.png",
		"syntaxes/mask.injection.json"
	],
	"scripts": {
		"vscode:prepublish": "npm run compile",
		"compile": "tsc -p ./",
		"lint": "eslint src test",
		"test": "npm run compile && node --test",
		"watch": "tsc -w -p ./"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@types/vscode": "^1.146.0",
		"eslint": "^10.14.0",
		"typescript": "~6.0.3",
		"typescript-eslint": "^8.72.2"
	}
}
